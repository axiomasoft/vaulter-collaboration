# Live Laravel host for the collab e2e stack — Orchestra Testbench served on Postgres.
# The host PHP has no pdo_pgsql; this image provides it so the stand runs on Postgres.
FROM php:8.4-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev libonig-dev git unzip \
    && docker-php-ext-install pdo_pgsql mbstring \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV TESTBENCH_WORKING_PATH=/tmp/vaulter-testbench-config
COPY --chmod=755 testbench-entrypoint.sh /usr/local/bin/vaulter-testbench
ENTRYPOINT ["vaulter-testbench"]
CMD ["vendor/bin/testbench", "serve", "--host", "0.0.0.0", "--port", "8000"]
