{
    "name": "axiomasoft/vaulter-collaboration-monorepo",
    "description": "Vaulter Collaboration — universal protocol-neutral live-room engine (private monorepo workspace).",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/axiomasoft/vaulter-collaboration",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/vaulter-collaboration/issues",
        "source": "https://github.com/axiomasoft/vaulter-collaboration"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/vaulter-collaboration": "1.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress"
    }
}
