{
  "name": "@vaulter/vue-collaboration",
  "version": "0.0.0",
  "description": "Realtime collaboration (Yjs over Hocuspocus) for @vaulter/vue: update envelopes, a bounded queue with acks, and save statuses.",
  "vaulter": {
    "api": "1"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "type": "module",
  "keywords": [
    "vue",
    "yjs",
    "hocuspocus",
    "collaboration",
    "documents",
    "vaulter"
  ],
  "homepage": "https://github.com/axiomasoft/vaulter-collaboration#readme",
  "bugs": "https://github.com/axiomasoft/vaulter-collaboration/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomasoft/vaulter-collaboration.git",
    "directory": "packages/vue-collaboration"
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": false
  },
  "files": [
    "dist"
  ],
  "main": "./dist/vaulter-vue-collaboration.umd.cjs",
  "module": "./dist/vaulter-vue-collaboration.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vaulter-vue-collaboration.js",
      "require": "./dist/vaulter-vue-collaboration.umd.cjs"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@vaulter/vue": "^1.0",
    "vue": "^3.5.42",
    "yjs": "^13.6.33"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.9.0"
  },
  "devDependencies": {
    "@vaulter/vue": "file:../../../vaulter/packages/vue",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.42",
    "vue-tsc": "^2.1.0",
    "yjs": "^13.6.33"
  }
}
