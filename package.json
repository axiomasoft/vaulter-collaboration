{
  "name": "vaulter-collaboration",
  "version": "0.0.0",
  "private": true,
  "description": "Vaulter Collaboration — universal protocol-neutral live-room engine.",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "workspaces": [
    "packages/vue-collaboration",
    "packages/hub"
  ],
  "scripts": {
    "test:vue": "npm --workspace=packages/vue-collaboration test",
    "test:hub": "npm --workspace=packages/hub test",
    "check:hub": "npm --workspace=packages/hub run check && tsc -p packages/hub/tsconfig.json",
    "build:vue": "npm --workspace=packages/vue-collaboration run build",
    "test": "npm run test:vue && npm run test:hub"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
